      "[data-testid=\"mainFeed\"] :is([role=\"listitem\"], [data-lazy-mount-id]):has(svg[id=\"trending-small\"]):not(:has(svg[id=\"overflow-web-ios-small\"]))"
     ]
    },
    {
     "id": "ads",
     "name": "promoted sidebar ads",
     "default": true,
     "css": [
      ".ad-banner-container",
      "[data-ad-banner]",
      ".scaffold-layout__aside .artdeco-card:has([data-ad-banner])",
      "iframe[componentkey$=\"_ad\"]",
      "iframe[width=\"300\"][height=\"250\"]"
     ]
    },
    {
     "id": "badges",
     "name": "notification counts",
     "default": false,
     "css": [
      ".notification-badge",
      ".notification-badge--show",
      ".notification-badge__count",
      ".nav-item__badge-count",
      "[data-testid=\"primary-nav\"] [class*=\"notification-badge\"]",
      ".msg-overlay-bubble-header__badge",
      "[data-testid=\"primary-nav\"] li > :is(a, button) > span > svg + span",
      "header nav li > :is(a, button) > span > svg + span",
      ".msg-overlay-bubble-header__unread-count",
      "#interop-outlet >>> .msg-overlay-bubble-header__unread-count",
      "#interop-outlet >>> .msg-overlay-bubble-header__badge-container"
     ]
    }
   ]
  }
 ]
}
